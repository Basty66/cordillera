              "raw": "{\n  \"passwordActual\": \"admin123\",\n  \"passwordNueva\": \"nuevapassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "password"]
            },
