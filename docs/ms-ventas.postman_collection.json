{
  "info": {
    "name": "MS Ventas — Plataforma de Monitoreo Inteligente",
    "description": "Colección completa de endpoints para la Plataforma de Monitoreo Inteligente. Grupo Cordillera. Incluye API Gateway, BFF, ms-ventas, ms-datos-org y ms-indicadores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "grupo-cordillera"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth (BFF)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token || json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica un usuario y retorna un token JWT"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevousuario\",\n  \"password\": \"password123\",\n  \"nombre\": \"Nuevo Usuario\",\n  \"email\": \"nuevo@example.com\",\n  \"rol\": \"VENDEDOR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          }
        },
        {
          "name": "Listar Usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/auth/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "usuarios"]
            },
            "description": "Lista todos los usuarios registrados (solo ADMIN)"
          }
        },
        {
          "name": "Actualizar Perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin Actualizado\",\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
